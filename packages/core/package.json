{
  "name": "@cognis/core",
  "version": "0.0.1",
  "private": true,
  "description": "cognis core: schema, pipelines, engines and the API contract",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "check": "npm run typecheck && npm run test && npm run verify:manifest",
    "verify:manifest": "node scripts/verify-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  }
}
